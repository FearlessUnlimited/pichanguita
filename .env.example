# Copia este archivo como .env.local y completa con los datos del proyecto Supabase (Settings → API).
# La clave anon es pública por diseño: la seguridad está en RLS y en las funciones RPC.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# '/' en local o con dominio propio; '/pichanguita/' en GitHub Pages.
VITE_BASE=/
